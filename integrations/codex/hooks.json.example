{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/aporic hook codex",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/aporic hook codex",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
