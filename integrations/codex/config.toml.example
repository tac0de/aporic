# Merge this section into ~/.codex/config.toml only after building the release
# binary and verifying the absolute checkout path on the target machine.
[mcp_servers.aporic]
command = "/absolute/path/to/aporic/target/release/aporic"
args = ["mcp", "serve", "--stdio"]
cwd = "/absolute/path/to/aporic"
startup_timeout_sec = 5
