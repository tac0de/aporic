{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/aporic\" codex-global-session-start",
            "timeout": 5,
            "statusMessage": "Loading Aporic commitment state",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/aporic\" codex-global-user-prompt-submit",
            "timeout": 5,
            "statusMessage": "Applying Aporic intent fidelity",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/aporic\" codex-global-pre-tool-use",
            "timeout": 5,
            "statusMessage": "Checking Aporic execution gate"
          }
        ]
      }
    ]
  }
}
