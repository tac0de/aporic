{
  "description": "Clean-room Aporic lifecycle adapter.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\"",
            "timeout": 5,
            "statusMessage": "Loading Aporic handoff",
            "additionalContextLimit": 4096
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\"",
            "timeout": 5,
            "statusMessage": "Checking exact Aporic grant"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\"",
            "timeout": 5,
            "statusMessage": "Recording Aporic effect"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\"",
            "timeout": 5,
            "statusMessage": "Projecting Aporic handoff"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "^other$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\"",
            "timeout": 5,
            "statusMessage": "Sealing Aporic day"
          }
        ]
      }
    ]
  }
}
