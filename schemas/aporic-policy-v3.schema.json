{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/aporic-policy-v3.json",
  "title": "Aporic risk-gated exact-tool policy v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": { "const": 3 },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[!-~]{1,256}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "require_plan",
          "require_grant",
          "require_intent",
          "auto_allow_low_risk_profiles"
        ],
        "properties": {
          "require_plan": { "type": "boolean" },
          "require_grant": { "type": "boolean" },
          "require_intent": { "type": "boolean" },
          "auto_allow_low_risk_profiles": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["profile_id", "profile_version"],
              "properties": {
                "profile_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[!-~]{1,128}$"
                },
                "profile_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[!-~]{1,128}$"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "require_intent": { "const": true } },
              "required": ["require_intent"]
            },
            "then": {
              "anyOf": [
                { "properties": { "require_plan": { "const": true } }, "required": ["require_plan"] },
                { "properties": { "require_grant": { "const": true } }, "required": ["require_grant"] }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "auto_allow_low_risk_profiles": { "minItems": 1 }
              },
              "required": ["auto_allow_low_risk_profiles"]
            },
            "then": {
              "properties": {
                "require_plan": { "const": true },
                "require_grant": { "const": false },
                "require_intent": { "const": true }
              }
            }
          }
        ]
      }
    }
  }
}
