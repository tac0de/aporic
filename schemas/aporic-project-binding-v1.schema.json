{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.local/schemas/aporic-project-binding-v1.schema.json",
  "title": "Aporic project binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "workspace",
    "remote_name",
    "remote_url",
    "bound_head",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,128}$"
    },
    "workspace": { "type": "string", "minLength": 1 },
    "remote_name": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,128}$"
    },
    "remote_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "bound_head": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
