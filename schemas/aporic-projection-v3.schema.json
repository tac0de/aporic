{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/aporic-projection-v3.json",
  "title": "Aporic multi-tool recorded-state projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "scope", "coverage", "executions"],
  "properties": {
    "schema": { "const": 3 },
    "revision": { "type": "integer", "minimum": 0 },
    "session_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "scope_omitted": { "type": "boolean" },
    "coverage": { "enum": ["observed_only", "unavailable"] },
    "reason_code": { "type": "string" },
    "protected_tool_count": { "type": "integer", "minimum": 0 },
    "omitted_tool_count": { "type": "integer", "minimum": 0 },
    "omitted_execution_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_count",
        "allowed",
        "held",
        "plan_authorization_required",
        "execution_grant_required",
        "tool_use_already_consumed",
        "active_hold_count",
        "matching_plan_authorization_count",
        "matching_execution_grant_count"
      ],
      "properties": {
        "tool_count": { "type": "integer", "minimum": 1 },
        "allowed": { "type": "integer", "minimum": 0 },
        "held": { "type": "integer", "minimum": 0 },
        "plan_authorization_required": { "type": "integer", "minimum": 0 },
        "execution_grant_required": { "type": "integer", "minimum": 0 },
        "tool_use_already_consumed": { "type": "integer", "minimum": 0 },
        "active_hold_count": { "type": "integer", "minimum": 0 },
        "matching_plan_authorization_count": { "type": "integer", "minimum": 0 },
        "matching_execution_grant_count": { "type": "integer", "minimum": 0 }
      }
    },
    "authenticated_human_authority": { "const": false },
    "budget": { "type": "object" },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_name", "require_plan", "require_grant", "status"],
        "properties": {
          "tool_name": { "type": "string", "minLength": 1 },
          "require_plan": { "type": "boolean" },
          "require_grant": { "type": "boolean" },
          "status": {
            "enum": [
              "allowed",
              "held",
              "plan_authorization_required",
              "execution_grant_required",
              "tool_use_already_consumed",
              "unknown"
            ]
          },
          "active_hold_count": { "type": "integer", "minimum": 0 },
          "matching_plan_authorization_count": { "type": "integer", "minimum": 0 },
          "matching_execution_grant_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "blocked_transition_kinds": { "type": "array", "uniqueItems": true },
    "complete": { "type": "boolean" },
    "omission_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_rule", "identity", "identity_kind"],
      "properties": {
        "selection_rule": { "type": "string" },
        "identity": { "type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$" },
        "identity_kind": { "const": "informational_non_cryptographic" }
      }
    },
    "active_decisions": { "type": "array" },
    "open_aporia": { "type": "array" },
    "active_delegations": { "type": "array" },
    "accepted_risks": { "type": "array" },
    "retained": { "type": "object" },
    "omitted": { "type": "object" }
  }
}
