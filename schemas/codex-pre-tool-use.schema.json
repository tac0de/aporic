{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/codex-pre-tool-use-v1.json",
  "title": "Codex PreToolUse hook input used by Aporic",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "session_id",
    "hook_event_name",
    "cwd",
    "turn_id",
    "tool_name",
    "tool_use_id",
    "tool_input"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Runtime validation additionally enforces a 256 UTF-8 byte limit."
    },
    "hook_event_name": { "const": "PreToolUse" },
    "cwd": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "tool_name": { "type": "string", "minLength": 1 },
    "tool_use_id": { "type": "string", "minLength": 1 },
    "tool_input": true,
    "model": { "type": ["string", "null"] },
    "permission_mode": { "type": ["string", "null"] }
  }
}
