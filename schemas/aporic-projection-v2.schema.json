{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/aporic-projection-v2.json",
  "title": "Aporic bounded recorded-state projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "scope", "coverage", "execution"],
  "properties": {
    "schema": { "const": 2 },
    "revision": { "type": "integer", "minimum": 0 },
    "session_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "scope_omitted": { "type": "boolean" },
    "coverage": { "enum": ["observed_only", "unavailable"] },
    "reason_code": {
      "enum": [
        "STORE_NOT_FOUND",
        "STORE_BUSY",
        "STORE_INVALID",
        "STORE_UNAVAILABLE"
      ]
    },
    "authenticated_human_authority": { "const": false },
    "budget": { "$ref": "#/$defs/budget" },
    "execution": { "$ref": "#/$defs/execution" },
    "blocked_transition_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/transitionKind" }
    },
    "complete": { "type": "boolean" },
    "active_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "open_aporia": {
      "type": "array",
      "items": { "$ref": "#/$defs/aporia" }
    },
    "active_delegations": {
      "type": "array",
      "items": { "$ref": "#/$defs/delegation" }
    },
    "accepted_risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "retained": { "$ref": "#/$defs/counts" },
    "omitted": { "$ref": "#/$defs/counts" }
  },
  "oneOf": [
    {
      "properties": {
        "coverage": { "const": "observed_only" },
        "execution": {
          "required": [
            "active_hold_count",
            "matching_plan_authorization_count"
          ],
          "properties": {
            "status": {
              "enum": ["allowed", "held", "plan_authorization_required"]
            }
          }
        }
      },
      "required": [
        "revision",
        "authenticated_human_authority",
        "budget",
        "blocked_transition_kinds",
        "complete",
        "active_decisions",
        "open_aporia",
        "active_delegations",
        "accepted_risks",
        "retained",
        "omitted"
      ],
      "not": {
        "anyOf": [
          { "required": ["scope_omitted"] },
          { "required": ["reason_code"] }
        ]
      }
    },
    {
      "properties": {
        "coverage": { "const": "unavailable" },
        "execution": {
          "properties": { "status": { "const": "unknown" } },
          "not": {
            "anyOf": [
              { "required": ["active_hold_count"] },
              { "required": ["matching_plan_authorization_count"] }
            ]
          }
        }
      },
      "required": ["scope_omitted", "reason_code"],
      "not": {
        "anyOf": [
          { "required": ["revision"] },
          { "required": ["authenticated_human_authority"] },
          { "required": ["budget"] },
          { "required": ["blocked_transition_kinds"] },
          { "required": ["complete"] },
          { "required": ["active_decisions"] },
          { "required": ["open_aporia"] },
          { "required": ["active_delegations"] },
          { "required": ["accepted_risks"] },
          { "required": ["retained"] },
          { "required": ["omitted"] }
        ]
      }
    }
  ],
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "limit"],
      "properties": {
        "unit": { "const": "utf8_bytes" },
        "limit": { "type": "integer", "minimum": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "require_plan", "status"],
      "properties": {
        "tool_name": { "type": "string", "minLength": 1 },
        "require_plan": { "type": "boolean" },
        "status": {
          "enum": [
            "allowed",
            "held",
            "plan_authorization_required",
            "unknown"
          ]
        },
        "active_hold_count": { "type": "integer", "minimum": 0 },
        "matching_plan_authorization_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "transitionKind": {
      "enum": [
        "decision_commit",
        "plan_authorize",
        "scope_change",
        "direction_supersede",
        "risk_accept",
        "completion_claim"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions", "aporia", "delegations", "risks"],
      "properties": {
        "decisions": { "type": "integer", "minimum": 0 },
        "aporia": { "type": "integer", "minimum": 0 },
        "delegations": { "type": "integer", "minimum": 0 },
        "risks": { "type": "integer", "minimum": 0 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "value", "authority_ref"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "value": { "type": "string" },
        "authority_ref": { "type": ["string", "null"] }
      }
    },
    "aporia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "blocks"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/transitionKind" }
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "grantee", "transition_kinds"],
      "properties": {
        "id": { "type": "string" },
        "grantee": { "type": "string" },
        "transition_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/transitionKind" }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "review_condition"],
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "review_condition": { "type": "string" }
      }
    }
  }
}
