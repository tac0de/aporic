{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/codex-session-start-v1.json",
  "title": "Codex SessionStart hook input used by Aporic",
  "type": "object",
  "additionalProperties": true,
  "required": ["session_id", "hook_event_name", "cwd", "source"],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Runtime validation additionally enforces a 256 UTF-8 byte limit."
    },
    "hook_event_name": { "const": "SessionStart" },
    "cwd": { "type": "string", "minLength": 1 },
    "source": { "enum": ["startup", "resume", "clear", "compact"] },
    "model": { "type": ["string", "null"] },
    "permission_mode": { "type": ["string", "null"] }
  }
}
