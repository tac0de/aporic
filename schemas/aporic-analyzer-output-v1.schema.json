{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/aporic-analyzer-output-v1.json",
  "title": "Aporic analyzer output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "based_on_revision", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "based_on_revision": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "subject_ids", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "conflict"] },
          "subject_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
