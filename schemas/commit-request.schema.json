{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/commit-request-v5.json",
  "title": "Aporic commit request v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "idempotency_key",
    "expected_revision",
    "actor",
    "scope",
    "event"
  ],
  "properties": {
    "schema_version": { "const": 5 },
    "event_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "provenance"],
      "properties": {
        "kind": { "enum": ["human", "agent", "evidence", "host"] },
        "id": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "scope": { "type": "string", "minLength": 1 },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/intentEnvelopeRecorded" },
        { "$ref": "#/$defs/intentEnvelopeSuperseded" },
        { "$ref": "#/$defs/aporiaOpened" },
        { "$ref": "#/$defs/aporiaResolved" },
        { "$ref": "#/$defs/delegationGranted" },
        { "$ref": "#/$defs/delegationRevoked" },
        { "$ref": "#/$defs/decisionCommitted" },
        { "$ref": "#/$defs/decisionSuperseded" },
        { "$ref": "#/$defs/riskAccepted" },
        { "$ref": "#/$defs/toolHoldPlaced" },
        { "$ref": "#/$defs/toolHoldReleased" },
        { "$ref": "#/$defs/planRegistered" },
        { "$ref": "#/$defs/planAuthorized" },
        { "$ref": "#/$defs/planAuthorizationRevoked" },
        { "$ref": "#/$defs/executionGrantIssued" },
        { "$ref": "#/$defs/executionGrantRevoked" },
        { "$ref": "#/$defs/executionGrantConsumed" },
        { "$ref": "#/$defs/evidenceRecorded" },
        { "$ref": "#/$defs/claimRecorded" },
        { "$ref": "#/$defs/claimStatusChanged" },
        { "$ref": "#/$defs/claimSuperseded" },
        { "$ref": "#/$defs/argumentRelationRecorded" },
        { "$ref": "#/$defs/argumentRelationRetracted" },
        { "$ref": "#/$defs/beliefRevisionRecorded" },
        { "$ref": "#/$defs/decisionBasisLinked" },
        { "$ref": "#/$defs/decisionReviewRecorded" },
        { "$ref": "#/$defs/planBasisLinked" },
        { "$ref": "#/$defs/actionOutcomeRecorded" },
        { "$ref": "#/$defs/effectReceiptRecorded" },
        { "$ref": "#/$defs/verificationRecorded" },
        { "$ref": "#/$defs/effectVerificationRecorded" },
        { "$ref": "#/$defs/planCompleted" },
        { "$ref": "#/$defs/checkpointPublished" },
        { "$ref": "#/$defs/checkpointClaimed" },
        { "$ref": "#/$defs/checkpointExpired" }
      ]
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "intentEnvelopeRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "intent_id", "source_ref", "goal", "explicit_items", "inferred_items", "unknown_items"],
      "properties": {
        "type": { "const": "intent_envelope_recorded" },
        "intent_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "explicit_items": { "$ref": "#/$defs/stringList" },
        "inferred_items": { "$ref": "#/$defs/stringList" },
        "unknown_items": { "$ref": "#/$defs/stringList" }
      }
    },
    "intentEnvelopeSuperseded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "intent_id", "replacement_intent_id", "reason"],
      "properties": {
        "type": { "const": "intent_envelope_superseded" },
        "intent_id": { "type": "string", "minLength": 1 },
        "replacement_intent_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "transitionKind": {
      "enum": [
        "decision_commit",
        "plan_authorize",
        "scope_change",
        "direction_supersede",
        "risk_accept",
        "completion_claim"
      ]
    },
    "aporiaOpened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "aporia_id", "question", "blocks"],
      "properties": {
        "type": { "const": "aporia_opened" },
        "aporia_id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/transitionKind" },
          "uniqueItems": true
        }
      }
    },
    "aporiaResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "aporia_id", "resolution_ref"],
      "properties": {
        "type": { "const": "aporia_resolved" },
        "aporia_id": { "type": "string", "minLength": 1 },
        "resolution_ref": { "type": "string", "minLength": 1 }
      }
    },
    "delegationGranted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "delegation_id", "grantee", "transition_kinds"],
      "properties": {
        "type": { "const": "delegation_granted" },
        "delegation_id": { "type": "string", "minLength": 1 },
        "grantee": { "type": "string", "minLength": 1 },
        "transition_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/transitionKind" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "delegationRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "delegation_id"],
      "properties": {
        "type": { "const": "delegation_revoked" },
        "delegation_id": { "type": "string", "minLength": 1 }
      }
    },
    "decisionCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "decision_id", "question", "value"],
      "properties": {
        "type": { "const": "decision_committed" },
        "decision_id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "authority_ref": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "decisionSuperseded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "decision_id", "replacement_id"],
      "properties": {
        "type": { "const": "decision_superseded" },
        "decision_id": { "type": "string", "minLength": 1 },
        "replacement_id": { "type": "string", "minLength": 1 }
      }
    },
    "riskAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "risk_id", "subject", "review_condition"],
      "properties": {
        "type": { "const": "risk_accepted" },
        "risk_id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "review_condition": { "type": "string", "minLength": 1 }
      }
    },
    "toolHoldPlaced": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tool_hold_id", "tool_name", "reason"],
      "properties": {
        "type": { "const": "tool_hold_placed" },
        "tool_hold_id": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "toolHoldReleased": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tool_hold_id"],
      "properties": {
        "type": { "const": "tool_hold_released" },
        "tool_hold_id": { "type": "string", "minLength": 1 }
      }
    },
    "planRegistered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "plan_id",
        "objective",
        "acceptance_checks",
        "unresolved_questions"
      ],
      "properties": {
        "type": { "const": "plan_registered" },
        "plan_id": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "acceptance_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unresolved_questions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "intent_id": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "planAuthorized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "authorization_id",
        "plan_id",
        "session_id",
        "tool_name"
      ],
      "properties": {
        "type": { "const": "plan_authorized" },
        "authorization_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "authority_ref": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "planAuthorizationRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "authorization_id"],
      "properties": {
        "type": { "const": "plan_authorization_revoked" },
        "authorization_id": { "type": "string", "minLength": 1 }
      }
    },
    "executionGrantIssued": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "grant_id",
        "plan_id",
        "session_id",
        "tool_name",
        "tool_input",
        "max_uses"
      ],
      "properties": {
        "type": { "const": "execution_grant_issued" },
        "grant_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "tool_input": true,
        "max_uses": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "authority_ref": { "type": ["string", "null"] }
      }
    },
    "executionGrantRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "grant_id"],
      "properties": {
        "type": { "const": "execution_grant_revoked" },
        "grant_id": { "type": "string", "minLength": 1 }
      }
    },
    "executionGrantConsumed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "grant_id", "tool_use_id"],
      "properties": {
        "type": { "const": "execution_grant_consumed" },
        "grant_id": { "type": "string", "minLength": 1 },
        "tool_use_id": { "type": "string", "minLength": 1 }
      }
    },
    "stringRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceRecorded": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "evidence_id", "kind", "locator", "digest"],
      "properties": {
        "type": { "const": "evidence_recorded" }, "evidence_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["user_statement", "repository_state", "test_result", "runtime_observation", "external_source", "agent_inference"] },
        "locator": { "type": "string", "minLength": 1 }, "digest": { "type": ["string", "null"] }
      }
    },
    "claimRecorded": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "claim_id", "statement", "status", "evidence_refs"],
      "properties": { "type": { "const": "claim_recorded" }, "claim_id": { "type": "string", "minLength": 1 }, "statement": { "type": "string", "minLength": 1 }, "status": { "enum": ["observed", "inferred", "hypothesized"] }, "evidence_refs": { "$ref": "#/$defs/stringRefs" } }
    },
    "claimStatusChanged": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "claim_id", "status", "evidence_refs"],
      "properties": { "type": { "const": "claim_status_changed" }, "claim_id": { "type": "string", "minLength": 1 }, "status": { "enum": ["observed", "inferred", "hypothesized", "verified", "refuted", "stale"] }, "evidence_refs": { "$ref": "#/$defs/stringRefs" } }
    },
    "claimSuperseded": { "type": "object", "additionalProperties": false, "required": ["type", "claim_id", "replacement_id"], "properties": { "type": { "const": "claim_superseded" }, "claim_id": { "type": "string", "minLength": 1 }, "replacement_id": { "type": "string", "minLength": 1 } } },
    "argumentRelationKind": { "enum": ["supports", "attacks", "depends_on", "contradicts"] },
    "argumentRelationRecorded": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "relation_id", "source_claim_id", "target_claim_id", "kind"],
      "properties": {
        "type": { "const": "argument_relation_recorded" },
        "relation_id": { "type": "string", "minLength": 1 },
        "source_claim_id": { "type": "string", "minLength": 1 },
        "target_claim_id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/argumentRelationKind" }
      }
    },
    "argumentRelationRetracted": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "relation_id", "evidence_refs"],
      "properties": {
        "type": { "const": "argument_relation_retracted" },
        "relation_id": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/stringRefs" }
      }
    },
    "beliefRevisionRecorded": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "revision_id", "claim_id", "prior_status", "revised_status", "trigger_claim_ids", "evidence_refs", "rationale"],
      "properties": {
        "type": { "const": "belief_revision_recorded" },
        "revision_id": { "type": "string", "minLength": 1 },
        "claim_id": { "type": "string", "minLength": 1 },
        "prior_status": { "enum": ["observed", "inferred", "hypothesized", "verified", "refuted", "stale"] },
        "revised_status": { "enum": ["observed", "inferred", "hypothesized", "verified", "refuted", "stale"] },
        "trigger_claim_ids": { "$ref": "#/$defs/stringRefs" },
        "evidence_refs": { "$ref": "#/$defs/stringRefs" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "decisionBasisLinked": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "decision_id", "claim_ids", "evidence_refs"],
      "properties": {
        "type": { "const": "decision_basis_linked" },
        "decision_id": { "type": "string", "minLength": 1 },
        "claim_ids": { "$ref": "#/$defs/stringRefs" },
        "evidence_refs": { "$ref": "#/$defs/stringRefs" }
      }
    },
    "decisionReviewRecorded": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "review_id", "decision_id", "outcome", "evidence_refs", "lessons", "follow_up_claim_ids"],
      "properties": {
        "type": { "const": "decision_review_recorded" },
        "review_id": { "type": "string", "minLength": 1 },
        "decision_id": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["confirmed", "revised", "reversed", "inconclusive"] },
        "evidence_refs": { "$ref": "#/$defs/stringRefs" },
        "lessons": { "$ref": "#/$defs/stringRefs" },
        "follow_up_claim_ids": { "$ref": "#/$defs/stringRefs" }
      }
    },
    "planBasisLinked": { "type": "object", "additionalProperties": false, "required": ["type", "plan_id", "evidence_refs", "assumption_claim_ids"], "properties": { "type": { "const": "plan_basis_linked" }, "plan_id": { "type": "string", "minLength": 1 }, "evidence_refs": { "$ref": "#/$defs/stringRefs" }, "assumption_claim_ids": { "$ref": "#/$defs/stringRefs" } } },
    "actionOutcomeRecorded": { "type": "object", "additionalProperties": false, "required": ["type", "session_id", "tool_name", "tool_use_id", "outcome", "evidence_refs"], "properties": { "type": { "const": "action_outcome_recorded" }, "session_id": { "type": "string", "minLength": 1 }, "tool_name": { "type": "string", "minLength": 1 }, "tool_use_id": { "type": "string", "minLength": 1 }, "outcome": { "enum": ["succeeded", "failed", "interrupted", "unknown"] }, "evidence_refs": { "$ref": "#/$defs/stringRefs" } } },
    "effectReceiptRecorded": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "receipt_id", "session_id", "tool_name", "tool_use_id", "tool_input_identity", "tool_response_identity", "outcome"],
      "properties": {
        "type": { "const": "effect_receipt_recorded" },
        "receipt_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "tool_use_id": { "type": "string", "minLength": 1 },
        "tool_input_identity": { "type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$" },
        "tool_response_identity": { "type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$" },
        "outcome": { "const": "unknown" }
      }
    },
    "verificationRecorded": { "type": "object", "additionalProperties": false, "required": ["type", "verification_id", "plan_id", "check_index", "result", "evidence_refs"], "properties": { "type": { "const": "verification_recorded" }, "verification_id": { "type": "string", "minLength": 1 }, "plan_id": { "type": "string", "minLength": 1 }, "check_index": { "type": "integer", "minimum": 0 }, "result": { "enum": ["passed", "failed", "inconclusive"] }, "evidence_refs": { "$ref": "#/$defs/stringRefs" } } },
    "effectVerificationRecorded": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "verification_id", "receipt_id", "verifier_id", "plan_id", "check_index", "result", "evidence_refs"],
      "properties": {
        "type": { "const": "effect_verification_recorded" },
        "verification_id": { "type": "string", "minLength": 1 },
        "receipt_id": { "type": "string", "minLength": 1 },
        "verifier_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "check_index": { "type": "integer", "minimum": 0 },
        "result": { "enum": ["passed", "failed", "inconclusive"] },
        "evidence_refs": { "$ref": "#/$defs/stringRefs" }
      }
    },
    "planCompleted": { "type": "object", "additionalProperties": false, "required": ["type", "plan_id", "residual_risk_refs"], "properties": { "type": { "const": "plan_completed" }, "plan_id": { "type": "string", "minLength": 1 }, "residual_risk_refs": { "$ref": "#/$defs/stringRefs" } } },
    "checkpointPublished": { "type": "object", "additionalProperties": false, "required": ["type", "checkpoint_id", "session_id", "objective", "verified_claim_ids", "unresolved_claim_ids", "aporia_ids", "next_checks", "artifact_refs"], "properties": { "type": { "const": "checkpoint_published" }, "checkpoint_id": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 }, "objective": { "type": "string", "minLength": 1 }, "verified_claim_ids": { "$ref": "#/$defs/stringRefs" }, "unresolved_claim_ids": { "$ref": "#/$defs/stringRefs" }, "aporia_ids": { "$ref": "#/$defs/stringRefs" }, "next_checks": { "$ref": "#/$defs/stringRefs" }, "artifact_refs": { "$ref": "#/$defs/stringRefs" } } },
    "checkpointClaimed": { "type": "object", "additionalProperties": false, "required": ["type", "checkpoint_id", "session_id"], "properties": { "type": { "const": "checkpoint_claimed" }, "checkpoint_id": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 } } },
    "checkpointExpired": { "type": "object", "additionalProperties": false, "required": ["type", "checkpoint_id"], "properties": { "type": { "const": "checkpoint_expired" }, "checkpoint_id": { "type": "string", "minLength": 1 } } }
  }
}
