{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/aporic-verifier-report-v1.json",
  "title": "Aporic independent verifier report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_id", "receipt_id", "verifier_id", "provenance", "plan_id", "check_index", "result", "evidence_refs"],
  "properties": {
    "schema_version": { "const": 1 },
    "verification_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "receipt_id": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "verifier_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "provenance": { "type": "string", "minLength": 1, "maxLength": 512 },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "check_index": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["passed", "failed", "inconclusive"] },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}
