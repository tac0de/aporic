{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/aporic-policy-v2.json",
  "title": "Aporic exact-tool policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": { "const": 2 },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[!-~]{1,256}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["require_plan", "require_grant", "require_intent"],
        "properties": {
          "require_plan": { "type": "boolean" },
          "require_grant": { "type": "boolean" },
          "require_intent": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "require_intent": { "const": true } },
              "required": ["require_intent"]
            },
            "then": {
              "anyOf": [
                { "properties": { "require_plan": { "const": true } }, "required": ["require_plan"] },
                { "properties": { "require_grant": { "const": true } }, "required": ["require_grant"] }
              ]
            }
          }
        ]
      }
    }
  }
}
