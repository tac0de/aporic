{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/aporic-projection-v6.json",
  "title": "Aporic bounded recorded-state projection v6",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "session_id", "scope", "coverage", "executions"],
  "properties": {
    "schema": { "const": 6 },
    "revision": { "type": "integer", "minimum": 0 },
    "session_id": { "type": "string" },
    "scope": { "type": "string" },
    "coverage": { "enum": ["observed_only", "unavailable"] },
    "executions": { "type": "array" },
    "active_intents": { "type": "array" },
    "open_aporia": {
      "type": "array",
      "items": { "$ref": "#/$defs/aporia" }
    },
    "active_claims": { "type": "array" },
    "active_argument_relations": { "type": "array" },
    "recent_belief_revisions": { "type": "array" },
    "recent_decision_reviews": { "type": "array" },
    "recent_action_outcomes": { "type": "array" },
    "recent_effect_receipts": { "type": "array" },
    "recent_effect_verifications": { "type": "array" },
    "claimed_checkpoint": { "type": "object" },
    "retained": { "$ref": "#/$defs/counts" },
    "omitted": { "$ref": "#/$defs/counts" },
    "complete": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "coverage": { "const": "observed_only" } } },
      "then": {
        "required": ["revision", "active_intents", "active_claims", "active_argument_relations", "recent_belief_revisions", "recent_decision_reviews", "recent_action_outcomes", "recent_effect_receipts", "recent_effect_verifications", "retained", "omitted", "complete"]
      }
    }
  ],
  "$defs": {
    "aporia": {
      "type": "object",
      "required": ["id", "question", "blocks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "blocks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "information_request": {
          "type": "object",
          "required": ["requested_materials", "collection_method", "selection_criteria", "intended_use"],
          "properties": {
            "requested_materials": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "collection_method": { "type": ["string", "null"] },
            "selection_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "intended_use": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["decisions", "aporia", "delegations", "risks", "intents", "claims", "argument_relations", "belief_revisions", "decision_reviews", "action_outcomes", "effect_receipts", "effect_verifications", "checkpoints"],
      "properties": {
        "decisions": { "type": "integer", "minimum": 0 },
        "aporia": { "type": "integer", "minimum": 0 },
        "delegations": { "type": "integer", "minimum": 0 },
        "risks": { "type": "integer", "minimum": 0 },
        "intents": { "type": "integer", "minimum": 0 },
        "claims": { "type": "integer", "minimum": 0 },
        "argument_relations": { "type": "integer", "minimum": 0 },
        "belief_revisions": { "type": "integer", "minimum": 0 },
        "decision_reviews": { "type": "integer", "minimum": 0 },
        "action_outcomes": { "type": "integer", "minimum": 0 },
        "effect_receipts": { "type": "integer", "minimum": 0 },
        "effect_verifications": { "type": "integer", "minimum": 0 },
        "checkpoints": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
