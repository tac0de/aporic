{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/aporic-analyzer-input-v1.json",
  "title": "Aporic analyzer input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "claims", "relations", "decision_bases"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "superseded"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["observed", "inferred", "hypothesized", "verified", "refuted", "stale"] },
          "superseded": { "type": "boolean" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_claim_id", "target_claim_id", "kind", "scope", "active", "retraction_evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_claim_id": { "type": "string", "minLength": 1 },
          "target_claim_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["supports", "attacks", "depends_on", "contradicts"] },
          "scope": { "type": "string", "minLength": 1 },
          "active": { "const": true },
          "retraction_evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "decision_bases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "claim_ids"],
        "properties": {
          "decision_id": { "type": "string", "minLength": 1 },
          "claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
