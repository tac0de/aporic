{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/plan-approval-request-v7.json",
  "title": "Aporic one-step plan approval request v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "expected_revision",
    "actor",
    "scope",
    "intent",
    "plan",
    "session_id",
    "tool_name",
    "authority_ref"
  ],
  "properties": {
    "schema_version": { "const": 7 },
    "approval_id": { "type": "string", "minLength": 1 },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "actor": { "$ref": "#/$defs/actor" },
    "scope": { "type": "string", "minLength": 1 },
    "intent": { "$ref": "#/$defs/intent" },
    "plan": { "$ref": "#/$defs/plan" },
    "session_id": { "type": "string", "minLength": 1 },
    "tool_name": { "type": "string", "minLength": 1 },
    "authority_ref": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "provenance"],
      "properties": {
        "kind": { "enum": ["human", "agent", "evidence", "host"] },
        "id": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "goal",
        "explicit_items",
        "inferred_items",
        "unknown_items"
      ],
      "properties": {
        "source_ref": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "explicit_items": { "$ref": "#/$defs/stringList" },
        "inferred_items": { "$ref": "#/$defs/stringList" },
        "unknown_items": { "$ref": "#/$defs/stringList" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "acceptance_checks", "unresolved_questions"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "acceptance_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unresolved_questions": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
