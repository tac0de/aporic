{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.dev/schema/codex-post-tool-use-v1.json",
  "title": "Codex PostToolUse hook input used by Aporic",
  "type": "object",
  "additionalProperties": true,
  "required": ["session_id", "hook_event_name", "cwd", "turn_id", "tool_name", "tool_use_id", "tool_input", "tool_response"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "hook_event_name": { "const": "PostToolUse" },
    "cwd": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tool_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tool_use_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tool_input": true,
    "tool_response": true,
    "model": { "type": ["string", "null"] },
    "permission_mode": { "type": ["string", "null"] }
  }
}
