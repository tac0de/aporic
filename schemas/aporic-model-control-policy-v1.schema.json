{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aporic.invalid/schemas/aporic-model-control-policy-v1.schema.json",
  "title": "Aporic model-control policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enforcement", "codex_executable", "tiers"],
  "properties": {
    "schema_version": {"const": 1},
    "enforcement": {"enum": ["advisory", "required"]},
    "codex_executable": {"type": "string", "minLength": 1},
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["economy", "balanced", "deep"],
      "properties": {
        "economy": {"$ref": "#/$defs/target"},
        "balanced": {"$ref": "#/$defs/target"},
        "deep": {"$ref": "#/$defs/target"}
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
        "reasoning_effort": {
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
        }
      }
    }
  }
}
